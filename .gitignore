# Private project registry (copy projects.example.md to projects.md)
projects.md
# ...and any backup of it. The registry is private; a stray .bak or .orig would
# commit the whole thing into a repo meant to be shareable.
projects.md.*

# Per-project detail files split out of the registry. Same content, same
# privacy: these hold the bulk of the project knowledge and must never ship.
registry/

# Personal Claude Code permission grants
.claude/settings.local.json

# audit-docs skill state
.claude/audit-state.local.json

# Private cross-project standards (copy standards.example/ to standards/)
standards/

# Personal folder link config (copy personal-links.example.conf)
personal-links.conf
